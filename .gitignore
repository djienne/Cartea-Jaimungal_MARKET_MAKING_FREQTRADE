HL_data/

# Generated parameter/output JSON files.
# The user_data/strategies copies are written every estimator cycle (~30s) by
# periodic_test_runner; tracking them turned every commit into calibration churn
# and made real changes hard to see in a diff.
scripts/*.json
user_data/strategies/kappa.json
user_data/strategies/epsilon.json
user_data/strategies/lambda.json
user_data/strategies/lambda_trades.json

# Local secrets for docker-compose (API-server credentials).
.env

# Logs and debug output
user_data/logs/
user_data/logs/mm_debug.jsonl*
user_data/strategies/param_update_status.json
user_data/strategies/param_update.lock

# Local trade database (+ -wal/-shm)
user_data/tradesv3.sqlite*
# Per-instance dry-run databases (mm-long / mm-short).
user_data/tradesv3_*.sqlite*
# Local-only compose overrides (e.g. mounting the collector's real data dir).
docker-compose.override.yml

# Python bytecode cache
__pycache__/
*.pyc

# AI review bundles generated by scripts/bundle_project.py
project_bundle*.md

# Reference books and other large binaries stay local. The Cartea-Jaimungal
# textbook was committed once by accident (32 MB, and not ours to
# redistribute) and had to be stripped from history with git-filter-repo.
docs/*.pdf
# ...except our own writing. This one is ~0.7 MB, is generated from
# docs/spread_calculation.tex in this repo, and the README links to it, so it
# has to be committed or the link is dead for everyone but us.
!docs/spread_calculation.pdf

# LaTeX build artefacts
docs/*.aux
docs/*.fdb_latexmk
docs/*.fls
docs/*.log
docs/*.out
docs/*.toc
docs/*.synctex.gz

# Rust engine build/runtime artifacts. Source, Cargo.lock and example profiles
# remain tracked; account state and live calibration output are local evidence.
rust_live/target/
rust_live/fuzz/target/
rust_live/run/
rust_live/config/local.toml
rust_live/config/*.acceptance.local.toml
rust_live/config/*.state.json
rust_live/config/*.snapshot.json
rust_live/reports/

# Real Hyperliquid credentials are local-only. The dummy template remains
# tracked and is safe to copy before replacing its values locally.
hyperliquid.env
!hyperliquid.env.example
