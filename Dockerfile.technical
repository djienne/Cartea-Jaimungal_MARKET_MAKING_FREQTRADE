FROM freqtradeorg/freqtrade:2025.4

# ccxt is pinned above the image's 4.4.77: that version's hyperliquid spot-market
# parser crashes on current exchange metadata (None base token -> TypeError in
# fetch_spot_markets), crash-looping freqtrade at startup. 4.5.22 supports
# options.fetchMarkets.types=["swap"] (set in user_data/config.json) so the spot
# parser is never invoked for this futures-only bot. NOTE: 4.5.22 reports the
# documented HL maker fee 0.00015 (4.4.77 said 0.0001); config fee/maker_fee_rate
# must match it or the strategy's fee gate fail-closes.
RUN pip3 install ta tqdm scipy plotly matplotlib pandas pyarrow redis "ccxt==4.5.22"
