# Two-sided market making needs two Freqtrade instances, because Freqtrade rests
# at most one order per pair and suppresses an exit signal whenever an entry is
# on the same candle. Hyperliquid perps net one-way per coin, so the two
# instances must sit on separate SUB-ACCOUNTS to hold an independent long and
# short; net inventory q = q_long + q_short is shared over Redis.
#
#   mm-long  -- can_short false, own inventory q_L >= 0
#   mm-short -- short-only,      own inventory q_S <= 0
#
# The ./user_data mount is deliberately SHARED. The contention that killed
# hl-collector2 came from two *writers*; here both freqtrade instances only READ
# the param files (run_estimators_in_strategy=false) and there is exactly one
# estimator. What must not be shared is the sqlite db, the logfile and the
# role config -- those are split per instance below.
x-freqtrade-common: &freqtrade-common
  image: ft-cartea-jaimungal_market_making_freqtrade:2025.10
  build:
    context: .
    dockerfile: "./Dockerfile.technical"
  restart: unless-stopped
  deploy:
    resources:
      limits:
        cpus: '0.25'
        memory: '1024M'
  volumes:
    - "./user_data:/freqtrade/user_data"
    - "./scripts:/freqtrade/scripts"
    - "./docs:/freqtrade/docs"
  depends_on:
    redis:
      condition: service_healthy

x-freqtrade-env: &freqtrade-env
  # Read the κ/ε/λ snapshot from Redis (atomic, no torn reads); falls back
  # to the JSON files under user_data/strategies if Redis is unavailable.
  REDIS_URL: ${REDIS_URL:-redis://redis:6379/0}
  # API-server credentials come from the environment, not from the tracked
  # config.json, which used to carry the username, password and JWT secret
  # in plaintext. Set these in a local .env (gitignored) beside this file.
  # NOTE: the previous values are still in git history and should be treated
  # as compromised -- pick new ones rather than re-entering the old.
  FREQTRADE__API_SERVER__USERNAME: ${MM_API_USERNAME:?set MM_API_USERNAME in .env}
  FREQTRADE__API_SERVER__PASSWORD: ${MM_API_PASSWORD:?set MM_API_PASSWORD in .env}
  FREQTRADE__API_SERVER__JWT_SECRET_KEY: ${MM_API_JWT_SECRET:?set MM_API_JWT_SECRET in .env}

services:
  mm-long:
    <<: *freqtrade-common
    container_name: MM_ADV_LONG
    environment:
      <<: *freqtrade-env
      MM_ROLE: long
    # ports:
    #   - "127.0.0.1:3004:8080"
    command: >
      trade
      --logfile /freqtrade/user_data/logs/freqtrade_long.log
      --db-url sqlite:////freqtrade/user_data/tradesv3_long.sqlite
      --config /freqtrade/user_data/config.json
      --config /freqtrade/user_data/config.long.json
      --strategy Market_Making

  mm-short:
    <<: *freqtrade-common
    container_name: MM_ADV_SHORT
    environment:
      <<: *freqtrade-env
      MM_ROLE: short
    # ports:
    #   - "127.0.0.1:3005:8080"
    command: >
      trade
      --logfile /freqtrade/user_data/logs/freqtrade_short.log
      --db-url sqlite:////freqtrade/user_data/tradesv3_short.sqlite
      --config /freqtrade/user_data/config.json
      --config /freqtrade/user_data/config.short.json
      --strategy Market_Making
  # hl-collector2 REMOVED 2026-08-16. It was a byte-for-byte duplicate of the
  # hl-collector defined in ./scripts/docker-compose.yml: same build context
  # (./scripts), same run_collector.py, same SYMBOLS, and — the part that did
  # real damage — the same host directory (./scripts/HL_data). Two collectors
  # subscribed to the same public Hyperliquid feed and each wrote its own
  # timestamped shard, so every trade landed on disk twice under two different
  # filenames. estimator_common._load_parquet_dir() concatenates every
  # *.parquet in the directory and normalize_trades() does not de-duplicate, so
  # n_trades and lambda± were inflated ~2x (measured 2104 rows / 1055 unique
  # trade_id = 1.994). The prices/orderbook streams survived only because
  # build_bbo_mid()/build_orderbook_mid() collapse on ts_ms.
  #
  # The collector now comes solely from ./scripts/docker-compose.yml, which
  # folder_list.txt starts under the "Data collectors" section. Do NOT
  # reintroduce a collector here; if this stack is ever revived, it consumes
  # ./scripts/HL_data that the scripts project fills.
  param-estimator:
    image: ft-cartea-jaimungal_market_making_freqtrade:2025.10
    build:
      context: .
      dockerfile: "./Dockerfile.technical"
    container_name: mm-param-estimator
    deploy:
      resources:
        limits:
          cpus: '0.25'
          memory: '1024M'
    environment:
      CRYPTO_NAME: ${PARAM_ESTIMATOR_SYMBOL:-CASHCAT}
      # Headless matplotlib backend so the estimator scripts import cleanly.
      MPLBACKEND: Agg
      # Unbuffered stdout so `docker logs` shows runner output as it happens.
      PYTHONUNBUFFERED: 1
      # Publish each fresh κ/ε/λ snapshot to Redis as one atomic blob.
      REDIS_URL: ${REDIS_URL:-redis://redis:6379/0}
      TZ: ${TZ:-UTC}
    volumes:
      - "./user_data:/freqtrade/user_data"
      - "./scripts:/freqtrade/scripts"
      - "./docs:/freqtrade/docs"
    # No depends_on for the collector: it lives in a separate compose project
    # (./scripts), so compose cannot order against it. The estimator already
    # tolerates a cold HL_data directory — it reports insufficient_data and
    # retries after --interval seconds.
    depends_on:
      redis:
        condition: service_healthy
    restart: unless-stopped
    # The freqtrade base image sets ENTRYPOINT=freqtrade; override it so we can
    # run the estimator script directly with python.
    entrypoint: ["python"]
    command: >
      /freqtrade/user_data/strategies/periodic_test_runner.py
      --loop
      --interval ${PARAM_ESTIMATOR_INTERVAL:-30}
      --crypto ${PARAM_ESTIMATOR_SYMBOL:-CASHCAT}
      --lock-stale-seconds ${PARAM_UPDATE_LOCK_STALE_SECONDS:-3600}
      --minutes ${PARAM_ESTIMATOR_WINDOW_MINUTES:-120}
  redis:
    image: redis:7-alpine
    container_name: mm-redis
    # noeviction: the params blob must never be silently evicted; at 64mb the
    # limit is unreachable for a single small key, and writes fail loudly if
    # something ever does fill the instance.
    command: ["redis-server", "--save", "", "--appendonly", "no", "--maxmemory", "64mb", "--maxmemory-policy", "noeviction"]
    restart: unless-stopped
    deploy:
      resources:
        limits:
          cpus: '0.25'
          memory: '128M'
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 3s
      retries: 5
