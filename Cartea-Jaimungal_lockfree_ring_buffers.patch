+            ask_reduce_only: AtomicBool::new(false),
+            quote_seq: AtomicU64::new(0),
+            model_revision: AtomicU64::new(0),
+            generated_ns: AtomicU64::new(0),
+            reason: AtomicU8::new(QuoteReason::Startup as u8),
+        };
+        value.store(DesiredQuotes::default());
