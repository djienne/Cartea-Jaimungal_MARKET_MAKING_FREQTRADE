+
+#[inline]
+fn store_desired_order(
+    valid: &AtomicBool,
+    side: &AtomicU8,
+    px: &AtomicI64,
+    qty_lots: &AtomicI64,
+    reduce_only: &AtomicBool,
+    order: Option<DesiredOrder>,
